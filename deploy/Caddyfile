# Caddy terminates TLS (certificates from Let's Encrypt, renewed
# automatically) and forwards everything to pickup-box.
#
# PICKUP_SITE_ADDRESS is set by docker-compose.yml from PICKUP_DOMAIN; it is
# ":80" (plain HTTP, for a quick test by IP) when no domain is configured.
{$PICKUP_SITE_ADDRESS::80} {
	# Internal endpoints are never exposed.
	@internal path /metrics /__blob/*
	respond @internal 404

	encode {
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	reverse_proxy pickup-box:80 {
		# Stream large downloads (zip archives) without buffering.
		flush_interval -1
	}

	header -Server
}
