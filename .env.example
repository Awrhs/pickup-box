# pickup-box configuration. Copy to .env and edit; only the first two
# settings are required on a public server.

# Your domain name (DNS must point to this server). Caddy gets the HTTPS
# certificate automatically. Leave empty to serve plain HTTP on port 80.
PICKUP_DOMAIN=files.example.com

# Upload password (at least 12 characters). Anyone with it can send files
# and manage all shares. Generate one with: openssl rand -base64 18
PICKUP_PASSWORD=change-me-to-a-long-password

# ---------------------------------------------------------------- optional --
# Extra uploaders, comma separated "name:password[:role]" (role upload|admin).
#PICKUP_USERS=mom:another-long-password,dad:yet-another-password

# Title shown on the pages.
#PICKUP_SITE_NAME=快传

# Limits: largest single file, files per share, and the rolling 30-day
# upload quota for each non-admin password (0 = unlimited).
#PICKUP_MAX_FILE_SIZE=2G
#PICKUP_MAX_FILES=200
#PICKUP_QUOTA=20G

# Stop accepting uploads when free disk space would fall below this percent.
#PICKUP_MIN_FREE_PERCENT=10

# Share lifetime: default, maximum and minimum (s, m, h, d, w units).
#PICKUP_DEFAULT_EXPIRY=7d
#PICKUP_MAX_EXPIRY=30d
#PICKUP_MIN_EXPIRY=10m

# Pickup code length (digits).
#PICKUP_CODE_LENGTH=6

# Image tag to run (deploy/docker-compose.yml), e.g. a pinned version.
#PICKUP_VERSION=latest

# Pull through a registry mirror when ghcr.io / Docker Hub are slow or
# unreachable from your server (e.g. mainland China), for example:
#PICKUP_IMAGE=ghcr.nju.edu.cn/awrhs/pickup-box
#CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2.8.4-alpine

# Prometheus: set a token to allow scraping /metrics from outside the
# container (Caddy never forwards /metrics, so scrape the container directly).
#PICKUP_METRICS_TOKEN=
