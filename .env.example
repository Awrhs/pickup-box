# pickup-box example configuration.
# Copy to .env and edit. `docker compose up` reads this file automatically.

# Reverse-proxy trust (set when running behind Caddy/nginx)
TRUST_X_FORWARDED_FOR=false
IMAGE_TRUSTED_PROXY_HOPS=1

# -------- Storage --------
IMAGE_DATA_DIR=/data/images
IMAGE_DB_PATH=/data/images/image.db

# API keys. Each entry is name:secret[:role[:quota[:expires]]].
# role is "upload" or "admin". quota is bytes per IMAGE_QUOTA_WINDOW_DAYS.
# expires is an absolute Unix timestamp (0 / omitted = never).
# Example: one uploader and one admin with a 1 GiB quota.
IMAGE_API_KEYS=alice:replace-with-long-random-secret:upload:1073741824,bob:replace-with-admin-secret:admin
IMAGE_API_KEY_FILE=
IMAGE_DEFAULT_QUOTA_BYTES=0
IMAGE_QUOTA_WINDOW_DAYS=30
IMAGE_MIN_KEY_LENGTH=16
IMAGE_ALLOW_QUERY_KEY=true

IMAGE_MAX_UPLOAD_BYTES=20971520
IMAGE_MAX_PIXELS=40000000
IMAGE_CACHE_SECONDS=31536000
IMAGE_ENABLE_PROCESSING=true
IMAGE_WATERMARK_PATH=
IMAGE_WATERMARK_OPACITY=0.3
IMAGE_WATERMARK_POSITION=southeast
IMAGE_UPLOAD_TITLE=pickup-box
IMAGE_VIPS_LIB=/opt/pickup-box/c/image_vips.so

IMAGE_MAX_CONCURRENCY=2
IMAGE_THREAD_POOL=default
IMAGE_ACQUIRE_TIMEOUT_MS=30000
UPLOAD_MAX_REQUESTS=30
UPLOAD_WINDOW=60

IMAGE_CACHE_MAX_BYTES=5368709120
IMAGE_L1_MAX_BYTES=262144
IMAGE_PREGENERATE_SIZES=320,640,1024,1920
IMAGE_PREGENERATE_FORMAT=webp
IMAGE_PREGENERATE_QUALITY=82

# Download-side protection
IMAGE_DOWNLOAD_RPM=600
IMAGE_DOWNLOAD_RATE_WINDOW=60
IMAGE_DOWNLOAD_REFERER_MODE=off
IMAGE_DOWNLOAD_REFERER_LIST=
IMAGE_DOWNLOAD_REFERER_ALLOW_EMPTY=false
IMAGE_DOWNLOAD_SIGNED_URLS=false
IMAGE_DOWNLOAD_SECRET=
IMAGE_DOWNLOAD_SIGN_TTL=3600
IMAGE_DOWNLOAD_METER=true

IMAGE_GC_INTERVAL=21600

# tus 1.0 chunked upload
IMAGE_TUS_EXPIRY=86400
IMAGE_TUS_MAX_CHUNK=8388608

# Stats flush interval
IMAGE_STATS_FLUSH_INTERVAL=60

# pHash perceptual hash
IMAGE_PHASH_ENABLED=true
IMAGE_PHASH_REJECT=false
IMAGE_PHASH_THRESHOLD=10
IMAGE_PHASH_BACKFILL=20

# Text watermark (requires a runtime-mounted font at IMAGE_TEXT_FONT_PATH)
IMAGE_TEXT_FONT_PATH=
IMAGE_TEXT_FONT_DESC=sans
IMAGE_WATERMARK_TEXT_SCALE=0.04
IMAGE_WATERMARK_MARGIN=16
IMAGE_WATERMARK_IMAGE_SCALE=0.2

# CORS (empty = same-origin only)
IMAGE_CORS_ORIGIN=
# Original-disposition: "inline" (default) or "attachment"
IMAGE_ORIGINAL_DISPOSITION=inline
# Set to true to refuse startup if a signing secret is weak.
IMAGE_REQUIRE_STRONG_SECRET=false
# Separate audit log (JSON lines)
IMAGE_AUDIT_LOG=/var/log/nginx/audit.log
